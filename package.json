{
  "name": "@l2utils/l2crypt",
  "version": "1.0.0",
  "description": "Lineage 2 cryptography library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "l2crypt": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "decode": "ts-node src/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/l2utils/l2crypt.git"
  },
  "keywords": [
    "Lineage 2",
    "cryptography",
    "l2encdec",
    "l2crypt"
  ],
  "author": "",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/l2utils/l2crypt/issues"
  },
  "homepage": "https://github.com/l2utils/l2crypt#readme",
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "commander": "^14.0.2"
  }
}
